{
  "name": "office-ai-closer",
  "version": "0.1.0",
  "description": "On-prem spreadsheet copilot for accountants. Deterministic reconciliation engine + BYO-key OpenRouter draft layer. Flags, never silently balances.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && python scripts/gen-icons.py && node scripts/build.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@microsoft/office-js": "^1.1.110",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
