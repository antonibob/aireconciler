# DeepSeek via its native Anthropic-compatible endpoint. No proxy required.
# Docs: https://api-docs.deepseek.com/guides/anthropic_api/
export ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
export ANTHROPIC_AUTH_TOKEN="${DEEPSEEK_API_KEY:?set DEEPSEEK_API_KEY first}"
unset ANTHROPIC_API_KEY   # a set API key outranks AUTH_TOKEN and would re-target Anthropic

# DeepSeek maps Claude model names server-side:
#   claude-opus*                  -> deepseek-v4-pro
#   claude-sonnet* / claude-haiku*-> deepseek-flash
#   anything unrecognised         -> deepseek-flash  (silently -- see README)
# Set these explicitly so a silent downgrade to flash can't masquerade as a
# parity result.
export ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
export ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro
export ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash

export API_TIMEOUT_MS=3000000   # cheaper models think longer; the default cuts runs short
export HARNESS_PROFILE=deepseek
