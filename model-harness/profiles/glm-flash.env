# GLM 5.3 Flash for the whole harness -- main loop, subagents and background.
# This is the aggressive, cheapest configuration.
#
# Z.ai's native Anthropic-compatible endpoint. No proxy required.
# Docs: https://docs.z.ai/devpack/tool/claude
export ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
export ANTHROPIC_AUTH_TOKEN="${ZAI_API_KEY:?set ZAI_API_KEY first}"
unset ANTHROPIC_API_KEY   # a set API key outranks AUTH_TOKEN and would re-target Anthropic

# Every alias points at Flash, including `opus` -- so the main agent loop runs
# on Flash rather than quietly falling back to the larger model. That is the
# setting under test; see the README on where Flash is expected to give way.
export ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.3-flash
export ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.3-flash
export ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-5.3-flash

# Flash is fast per token but takes more turns on agentic work; the stock
# timeout cuts long loops off mid-task and looks like a capability failure.
export API_TIMEOUT_MS=3000000

export HARNESS_PROFILE=glm-flash
